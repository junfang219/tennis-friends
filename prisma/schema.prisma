generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String?   @unique
  emailVerified      DateTime?
  phone              String?   @unique
  phoneVerified      DateTime?
  passwordHash       String?
  name               String
  bio                String    @default("")
  skillLevel         String    @default("intermediate")
  favoriteSurface    String    @default("hard")
  profileImageUrl    String    @default("")
  coverImageUrl      String    @default("")
  coverOffsetY       Int       @default(50)
  coverScale         Int       @default(100)
  customTags         String    @default("")
  latitude           Float?
  longitude          Float?
  gender             String    @default("")
  ageRange           String    @default("")
  ratingSystem       String    @default("")
  ntrpRating         Float?
  utrRating          Float?
  handle             String?   @unique
  venmoHandle        String?
  paypalHandle       String?
  cashappHandle      String?
  zelleHandle        String?
  onboardingComplete Boolean   @default(false)
  isPrivate          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  sentRequests             Friendship[]              @relation("Requester")
  receivedRequests         Friendship[]              @relation("Addressee")
  posts                    Post[]
  likes                    Like[]
  ownedGroups              Group[]                   @relation("GroupOwner")
  groupMemberships         GroupMember[]
  sentMessages             Message[]                 @relation("MessageSender")
  receivedMessages         Message[]                 @relation("MessageReceiver")
  groupMessages            GroupMessage[]
  playRequests             PlayRequest[]
  comments                 Comment[]
  hiddenPosts              HiddenPost[]
  notifications            Notification[]            @relation("NotificationRecipient")
  notificationsActed       Notification[]            @relation("NotificationActor")
  ownedFriendGroups        FriendGroup[]             @relation("FriendGroupOwner")
  friendGroupMemberships   FriendGroupMember[]
  createdChats             Chat[]                    @relation("ChatCreator")
  chatParticipations       ChatParticipant[]
  sentChatMessages         ChatMessage[]
  directMessageReads       DirectMessageRead[]
  blocksMade               Block[]                   @relation("Blocker")
  blocksReceived           Block[]                   @relation("Blocked")
  matchAvailabilities      MatchAvailability[]
  practiceAvailabilities   PracticeAvailability[]
  courtsAdded              Court[]                   @relation("CourtAdder")
  organizedBookings        Booking[]                 @relation("BookingOrganizer")
  bookingPlayers           BookingPlayer[]           @relation("BookingPlayerUser")
  paidExpenses             Expense[]                 @relation("ExpensePayer")
  expenseShares            ExpenseShare[]
  highlights               Highlight[]
  messageReactions         MessageReaction[]
  deviceTokens             DeviceToken[]
  courtReviews             CourtReview[]             @relation("CourtReviewAuthor")
  courtAvailabilityReports CourtAvailabilityReport[] @relation("CourtAvailabilityReporter")
  eventsOwned              Event[]                   @relation("EventOwner")
  eventParticipations      EventParticipant[]        @relation("EventParticipantUser")
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String
  mediaType String   @default("image")
  caption   String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id])
  addressee User @relation("Addressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

model Photo {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId])
}

model Post {
  id                String    @id @default(cuid())
  content           String    @default("")
  mediaUrl          String    @default("")
  mediaType         String    @default("")
  postType          String    @default("regular")
  playDate          String    @default("")
  playTime          String    @default("")
  playDuration      Int       @default(90)
  courtLocation     String    @default("")
  gameType          String    @default("")
  playersNeeded     Int       @default(0)
  playersConfirmed  Int       @default(0)
  skillMin          Float?
  skillMax          Float?
  courtBooked       Boolean   @default(false)
  isComplete        Boolean   @default(false)
  commentsDisabled  Boolean   @default(false)
  manualPlayers     String    @default("")
  teamGroupId       String    @default("")
  isBroadcast       Boolean   @default(false)
  broadcastRadiusMi Int       @default(0)
  broadcastLat      Float?
  broadcastLng      Float?
  eventId           String?
  authorId          String
  // When set, the post is pinned to the top of its group feed (Team Cowboy "Message Board" parity).
  pinnedAt          DateTime?
  createdAt         DateTime  @default(now())

  author              User                      @relation(fields: [authorId], references: [id])
  event               Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  likes               Like[]
  postGroups          PostGroup[]
  postFriendGroups    PostFriendGroup[]
  playRequests        PlayRequest[]
  comments            Comment[]
  hiddenBy            HiddenPost[]
  photos              Photo[]
  availabilityReports CourtAvailabilityReport[]

  @@index([isBroadcast, createdAt])
  @@index([eventId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Group {
  id            String   @id @default(cuid())
  name          String
  imageUrl      String   @default("")
  coverImageUrl String   @default("")
  coverOffsetY  Int      @default(50)
  coverScale    Int      @default(100)
  ownerId       String
  // JSON-encoded string[] of member type labels customizable per team
  // (e.g. ["Full-time","Sub","Coach","Parent","Guest"]). Defaults applied at API layer.
  memberTypes   String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner          User             @relation("GroupOwner", fields: [ownerId], references: [id])
  members        GroupMember[]
  postGroups     PostGroup[]
  groupMessages  GroupMessage[]
  matches        TeamMatch[]
  practiceSeries PracticeSeries[]
  seasons        Season[]
  event          Event?           @relation("GroupEvent")
  hostedEvents   Event[]          @relation("EventHostGroup")
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  // "OWNER" | "MANAGER" | "CAPTAIN" | "MEMBER" — see src/lib/groupRoles.ts.
  // Backfill sets OWNER for the row matching Group.ownerId; everyone else MEMBER.
  role       String    @default("MEMBER")
  // Free-text label drawn from Group.memberTypes (e.g. "Full-time", "Sub").
  memberType String    @default("")
  createdAt  DateTime  @default(now())
  lastReadAt DateTime  @default(now())
  muted      Boolean   @default(false)
  pinnedAt   DateTime?
  hiddenAt   DateTime?
  clearedAt  DateTime?
  archivedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId, role])
}

model PostGroup {
  id      String @id @default(cuid())
  postId  String
  groupId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([postId, groupId])
}

model Message {
  id           String   @id @default(cuid())
  content      String
  mediaUrl     String   @default("")
  mediaType    String   @default("")
  senderId     String
  receiverId   String
  sharedPostId String   @default("")
  createdAt    DateTime @default(now())

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id])
}

model GroupMessage {
  id           String    @id @default(cuid())
  content      String
  mediaUrl     String    @default("")
  mediaType    String    @default("")
  sharedPostId String    @default("")
  groupId      String
  senderId     String
  // "chat" (default) or "announcement". Announcements are highlighted in the UI
  // and fan out via email when notifyEmail is true (see PR #6).
  kind         String    @default("chat")
  notifyEmail  Boolean   @default(false)
  // Pinned announcements stick to the top of the chat thread.
  pinnedAt     DateTime?
  createdAt    DateTime  @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([groupId, kind, pinnedAt])
}

model PlayRequest {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  status    String   @default("PENDING")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model HiddenPost {
  id     String @id @default(cuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // recipient
  actorId   String // who triggered it
  type      String // "comment" | "like" | "join_request" | "request_approved" | "request_rejected" | "message_reaction" | "event_invite"
  postId    String   @default("")
  commentId String   @default("")
  messageId String   @default("")
  eventId   String   @default("")
  matchId   String   @default("") // EventMatch id; used for deep-linking to a specific match
  emoji     String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotificationRecipient", fields: [userId], references: [id])
  actor User @relation("NotificationActor", fields: [actorId], references: [id])
}

model FriendGroup {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User                @relation("FriendGroupOwner", fields: [ownerId], references: [id])
  members          FriendGroupMember[]
  postFriendGroups PostFriendGroup[]
  chat             Chat?
}

model FriendGroupMember {
  id            String   @id @default(cuid())
  friendGroupId String
  userId        String
  createdAt     DateTime @default(now())

  friendGroup FriendGroup @relation(fields: [friendGroupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([friendGroupId, userId])
}

model PostFriendGroup {
  id            String @id @default(cuid())
  postId        String
  friendGroupId String

  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  friendGroup FriendGroup @relation(fields: [friendGroupId], references: [id], onDelete: Cascade)

  @@unique([postId, friendGroupId])
}

model Chat {
  id                String    @id @default(cuid())
  name              String    @default("")
  creatorId         String
  postId            String?
  friendGroupId     String?   @unique
  sessionEndAt      DateTime?
  manualPlayerNames String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creator      User              @relation("ChatCreator", fields: [creatorId], references: [id])
  friendGroup  FriendGroup?      @relation(fields: [friendGroupId], references: [id], onDelete: SetNull)
  participants ChatParticipant[]
  messages     ChatMessage[]
  expenses     Expense[]

  @@index([sessionEndAt])
}

model Expense {
  id          String   @id @default(cuid())
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  payerId     String
  payer       User     @relation("ExpensePayer", fields: [payerId], references: [id])
  amountCents Int
  description String   @default("")
  createdAt   DateTime @default(now())

  shares      ExpenseShare[]
  guestShares GuestExpenseShare[]

  @@index([chatId])
}

model GuestExpenseShare {
  id          String    @id @default(cuid())
  expenseId   String
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  guestName   String
  amountCents Int
  settledAt   DateTime?

  @@unique([expenseId, guestName])
  @@index([expenseId])
}

model ExpenseShare {
  id          String    @id @default(cuid())
  expenseId   String
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amountCents Int
  settledAt   DateTime?

  @@unique([expenseId, userId])
  @@index([userId])
}

model ChatParticipant {
  id         String    @id @default(cuid())
  chatId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime  @default(now())
  muted      Boolean   @default(false)
  pinnedAt   DateTime?
  hiddenAt   DateTime?
  clearedAt  DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  mediaUrl  String   @default("")
  mediaType String   @default("")
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])
}

// Per-device push token for APNs / FCM. The same physical device can re-register
// under a different signed-in user; the unique constraint on token guarantees we
// only ever route a push to the most recent owner of that token.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Polymorphic per-user reactions for Message (DM), GroupMessage (GROUP), and ChatMessage (CHAT).
// One row per (messageType, messageId, userId) — the unique constraint enforces the iMessage-style
// single-reaction rule. No FK to message rows; orphans are filtered on read.
model MessageReaction {
  id          String   @id @default(cuid())
  messageType String
  messageId   String
  userId      String
  emoji       String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageType, messageId, userId])
  @@index([messageType, messageId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model DirectMessageRead {
  id         String    @id @default(cuid())
  userId     String // the reader (recipient who opened the chat)
  otherId    String // the other party in the 1:1 conversation
  lastReadAt DateTime  @default(now())
  muted      Boolean   @default(false)
  pinnedAt   DateTime?
  hiddenAt   DateTime?
  clearedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, otherId])
}

model TeamMatch {
  id         String   @id @default(cuid())
  groupId    String
  matchDate  String
  matchTime  String   @default("")
  location   String
  notes      String   @default("")
  // "home" | "away" | "" (unset). Affects which court the team is hosting at.
  homeAway   String   @default("")
  // Free text or hex; used for "wear-this" visibility on the match card.
  shirtColor String   @default("")
  // Optional opponent label (Team Cowboy stores opponent on each event).
  opponent   String   @default("")
  seasonId   String?
  createdAt  DateTime @default(now())

  group          Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  season         Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  availabilities MatchAvailability[]

  @@index([groupId, seasonId])
}

model MatchAvailability {
  id         String   @id @default(cuid())
  matchId    String
  userId     String
  status     String   @default("")
  matchTypes String   @default("")
  lineupSlot String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  match TeamMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
}

model PracticeSeries {
  id           String   @id @default(cuid())
  groupId      String
  name         String
  location     String
  practiceTime String   @default("")
  notes        String   @default("")
  seasonId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  season    Season?        @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  practices TeamPractice[]

  @@index([groupId, seasonId])
}

model TeamPractice {
  id           String   @id @default(cuid())
  seriesId     String
  practiceDate String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  series         PracticeSeries         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  availabilities PracticeAvailability[]
}

// A named span of time on a Group's calendar (e.g. "Summer 2026"). Matches,
// practice series, and hostGroup-attached events can be tagged with a seasonId
// so the calendar UI can filter. Inspired by Team Cowboy's "Seasons" concept.
model Season {
  id        String    @id @default(cuid())
  groupId   String
  name      String
  startDate DateTime?
  endDate   DateTime?
  // Only one season per group should be active at a time, but not enforced
  // at the DB layer — the API enforces the invariant on toggle.
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group   Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  matches TeamMatch[]
  series  PracticeSeries[]
  events  Event[]

  @@index([groupId, isActive])
}

model PracticeAvailability {
  id         String   @id @default(cuid())
  practiceId String
  userId     String
  status     String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  practice TeamPractice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])

  @@unique([practiceId, userId])
}

model Court {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  notes     String   @default("")
  addedById String
  createdAt DateTime @default(now())

  addedBy User @relation("CourtAdder", fields: [addedById], references: [id])

  @@index([addedById])
}

model Venue {
  id           String       @id @default(cuid())
  name         String
  address      String
  latitude     Float
  longitude    Float
  neighborhood String       @default("")
  amenities    String       @default("[]")
  imageUrl     String       @default("")
  activeNetId  String       @default("")
  courts       VenueCourt[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model VenueCourt {
  id          String    @id @default(cuid())
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id])
  courtNumber Int
  surface     String    @default("hard")
  isLighted   Boolean   @default(false)
  activeNetId String    @default("")
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([venueId, courtNumber])
}

model Booking {
  id           String          @id @default(cuid())
  courtId      String
  court        VenueCourt      @relation(fields: [courtId], references: [id])
  organizerId  String
  organizer    User            @relation("BookingOrganizer", fields: [organizerId], references: [id])
  startTime    DateTime
  endTime      DateTime
  status       String          @default("pending")
  activeNetUrl String          @default("")
  players      BookingPlayer[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([courtId, startTime, endTime])
}

model BookingPlayer {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  user      User     @relation("BookingPlayerUser", fields: [userId], references: [id])
  status    String   @default("invited")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, userId])
}

model CourtReview {
  id        String             @id @default(cuid())
  courtId   String
  userId    String
  user      User               @relation("CourtReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  content   String             @default("")
  photos    CourtReviewPhoto[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([courtId, userId])
  @@index([courtId])
}

model CourtAvailabilityReport {
  id         String   @id @default(cuid())
  courtId    String
  userId     String
  user       User     @relation("CourtAvailabilityReporter", fields: [userId], references: [id], onDelete: Cascade)
  hasEmpty   Boolean
  reportedAt DateTime @default(now())
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([courtId, reportedAt])
  @@index([userId, reportedAt])
}

model CourtReviewPhoto {
  id        String      @id @default(cuid())
  reviewId  String
  review    CourtReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  order     Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([reviewId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("EventOwner", fields: [ownerId], references: [id])

  // Backing chat/feed group, auto-created via ensureEventGroup()
  groupId String? @unique
  group   Group?  @relation("GroupEvent", fields: [groupId], references: [id])

  title       String
  description String @default("")
  eventType   String // "tournament" | "round_robin" | "mixer" | "clinic"

  startDate      DateTime
  endDate        DateTime
  signupDeadline DateTime?

  isPublicSignup  Boolean @default(true)
  maxParticipants Int?
  ntrpMin         Float?
  ntrpMax         Float?

  status       String @default("open") // "open" | "closed" | "active" | "completed" | "cancelled"
  venueName    String @default("")
  venueAddress String @default("")

  // Visibility scoping.
  // "public": anchored to (eventLat, eventLng); visible to viewers within radiusMi.
  // "group":  visible only to members of hostGroup. Mutually exclusive with postToFeed.
  visibility  String  @default("public")
  eventLat    Float?
  eventLng    Float?
  radiusMi    Int?
  hostGroupId String?
  hostGroup   Group?  @relation("EventHostGroup", fields: [hostGroupId], references: [id])

  // Loose JSON for type-specific config (bracket shape, mixer rounds, etc.).
  config String @default("")

  coverImageUrl String @default("")

  // Optional season grouping. Only meaningful when hostGroupId is set; the
  // referenced Season must belong to that hostGroup (enforced at the API layer).
  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  participants EventParticipant[]
  matches      EventMatch[]
  posts        Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startDate])
  @@index([ownerId])
  @@index([visibility, eventLat, eventLng])
  @@index([hostGroupId])
  @@index([seasonId])
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("EventParticipantUser", fields: [userId], references: [id])

  status       String    @default("registered") // "registered" | "waitlist" | "withdrawn"
  registeredAt DateTime  @default(now())
  checkedInAt  DateTime?

  // Per-event standings (filled by match results).
  wins     Int @default(0)
  losses   Int @default(0)
  setsWon  Int @default(0)
  setsLost Int @default(0)
  points   Int @default(0)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model EventMatch {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Up to 4 players (singles = 2, doubles = 4). Side 1 = players 1+3, side 2 = players 2+4.
  // No Prisma relations on these to avoid 4 back-relations on User; fetch users by id in API.
  player1Id String
  player2Id String
  player3Id String?
  player4Id String?

  round       Int? // round number for round-robin and tournament
  bracketSlot String @default("") // e.g. "QF-1", "SF-2" for tournament

  scheduledAt DateTime?
  courtAssign String    @default("")

  score       String    @default("") // e.g. "6-4,3-6,7-5"
  winnerSide  Int? // 1 or 2
  reportedBy  String    @default("") // userId who entered score
  confirmedBy String    @default("") // userId who confirmed
  proposedBy  String    @default("") // userId of the ladder challenger; empty for auto-generated
  disputedAt  DateTime?

  status    String   @default("scheduled") // "proposed" | "declined" | "scheduled" | "in_progress" | "completed" | "cancelled"
  createdAt DateTime @default(now())

  @@index([eventId, status])
  @@index([eventId, round])
}
