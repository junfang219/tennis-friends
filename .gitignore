# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# capacitor
# Track ios/ native sources so AppDelegate / project.pbxproj edits
# survive across machines and fresh clones. ios/.gitignore already
# excludes DerivedData/build/Pods/public/xcuserdata; the rules below
# catch a few stray Next.js / Finder artifacts that landed under ios/
# and shouldn't be tracked.
/ios/App/.next/
/ios/**/* 2.*
/out/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
".next 2"/
/out/

# database
*.db
*.db-journal
prisma/dev.db
prisma/dev.db-journal

# claude
.claude/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploaded files
/public/uploads/*
!/public/uploads/.gitkeep
secrets/

# local sqlite backups
prisma/dev.db.*

# macOS finder duplicates
* 2.ts
* 2.tsx

# /design-sync — staged converter scripts + regenerated build output + machine state.
# Durable inputs (.design-sync/config.json, NOTES.md, conventions.md, ds-src/) ARE committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
