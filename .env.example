DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ===== Supabase =====
# Modern key format (Supabase deprecated the legacy "anon" / "service_role" naming):
#   - publishable: sb_publishable_...  (safe in the browser bundle)
#   - secret:      sb_secret_...       (server only — bypasses RLS)
# Local dev: `npx supabase start` prints both. Cloud: dashboard → Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never expose. Never prefix NEXT_PUBLIC_. Rotate periodically.
SUPABASE_SECRET_KEY=

# ===== Sentry (error reporting) =====
# Create a project at https://sentry.io and paste the DSN here.
# Both vars are read; NEXT_PUBLIC_ is required for browser-side capture.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Trace sampling: 0.1 = 10% of requests get full performance traces.
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Google OAuth (optional — button hidden if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (optional — button hidden if unset).
# APPLE_SECRET is a pre-minted JWT from your .p8 key + Team ID + Key ID; expires ~6 months.
APPLE_ID=
APPLE_SECRET=

# Twilio Verify (optional — phone OTP falls back to dev mode with code "000000" if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Push delivery moved off Node: APNs now ships from the supabase/functions/
# push-fanout edge function (Deno + Web Crypto). The cron route reaches it
# via the same shared-secret gate the DB triggers use, so only this env var
# stays in the Vercel side.
#   - The value must match the `edge_function_trigger_secret` row in
#     Supabase Vault and the TRIGGER_SECRET env var on the push-fanout +
#     group-invite-email edge functions.
#   - Generate with `openssl rand -hex 32` and rotate by updating all three
#     locations in one window.
# Leave blank in environments where the cron shouldn't fire (e.g. local dev).
EDGE_FUNCTION_TRIGGER_SECRET=

# Court card "Report an issue" form.
# Sign up at https://resend.com to get an API key. Resend's default sender
# (`onboarding@resend.dev`) works without domain verification — fine for
# early dev. Leave RESEND_API_KEY blank to disable the feature; the endpoint
# returns 503 and the UI shows "Reporting isn't set up yet."
RESEND_API_KEY=
# Where issue reports get emailed. Server-side only (do NOT prefix
# NEXT_PUBLIC_ — we don't want this in the client bundle).
REPORT_EMAIL=
